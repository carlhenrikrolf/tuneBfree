{
  "permissions": {
    "deny": [
      "Read(~/.ssh/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "credentials": {
      "files": [
        {
          "path": "~/.ssh",
          "mode": "deny"
        }
      ]
    }
  }
}