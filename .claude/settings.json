{
    "sandbox": {
        "enabled": true,
        "filesystem": {
            "denyRead": [
                "/Users"
            ],
            "allowRead": [
                "."
            ],
            "denyWrite": [
                "./.claude/settings.json"
            ]
        }
    },
    "permissions": {
        "deny": [
            "Read(//**/.ssh/*)",
            "Write(//**/.ssh/*)",
            "Edit(//**/.ssh/*)",
            "Read(//**/.env*)",
            "Write(//**/.env*)",
            "Edit(//**/.env*)"
        ]
    }
}